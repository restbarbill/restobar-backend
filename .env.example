# ============================================================================
# AMBIENTE (development | production)
# ============================================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ============================================================================
# SUPABASE POSTGRESQL (TypeORM)
# En Supabase -> Project Settings -> Database -> Connection String
# DATABASE_URL: Usa el puerto 6543 (Transaction Pooler) para el servidor NestJS
# DIRECT_URL:   Usa el puerto 5432 (Session Pooler / Direct) para Migraciones
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restobar_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/restobar_dev
DB_SSL=false
DB_SYNCHRONIZE=true

# ============================================================================
# REDIS (BullMQ / Colas de Tiempo de Billar y Alertas)
# En Producción/Dev en la nube se provee desde Railway Redis
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# SEGURIDAD JWT
# ============================================================================
JWT_SECRET=change-this-super-secret-jwt-key-in-production
JWT_EXPIRES_IN=12h

# ============================================================================
# CLOUDINARY (Almacenamiento de Imágenes de Menú, Productos y Torneos)
# En Dev usa: restobar-dev | En Prod usa: restobar-prod
# ============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=restobar-dev
